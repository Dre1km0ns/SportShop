graph G { graph[fontname="DejaVu Sans",label="Диаграмма «сущность – связь» ИС «СпортТовары»",labelloc=t,fontsize=18,rankdir=LR]; node[fontname="DejaVu Sans",fontsize=12,shape=plaintext]; edge[fontname="DejaVu Sans",fontsize=11];
 cat[label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dbe9ff"><b>Категория</b></td></tr><tr><td align="left">PK id<br align="left"/>name<br align="left"/></td></tr></table>>];
 prod[label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dbe9ff"><b>Товар</b></td></tr><tr><td align="left">PK id<br align="left"/>name<br align="left"/>brand<br align="left"/>FK category_id<br align="left"/>price<br align="left"/></td></tr></table>>];
 size[label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dbe9ff"><b>Размер_остаток</b></td></tr><tr><td align="left">PK,FK product_id<br align="left"/>PK size<br align="left"/>quantity<br align="left"/></td></tr></table>>];
 cl[label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dbe9ff"><b>Клиент</b></td></tr><tr><td align="left">PK id<br align="left"/>fio<br align="left"/>phone<br align="left"/></td></tr></table>>];
 ord[label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dbe9ff"><b>Заказ</b></td></tr><tr><td align="left">PK id<br align="left"/>FK client_id<br align="left"/>date<br align="left"/>total<br align="left"/></td></tr></table>>];
 item[label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dbe9ff"><b>Позиция_заказа</b></td></tr><tr><td align="left">PK,FK order_id<br align="left"/>PK,FK product_id<br align="left"/>PK size<br align="left"/>quantity<br align="left"/>price<br align="left"/></td></tr></table>>];
 cat--prod[label="1 : N"]; prod--size[label="1 : N"]; cl--ord[label="1 : N"]; ord--item[label="1 : N"]; prod--item[label="1 : N"]; }
