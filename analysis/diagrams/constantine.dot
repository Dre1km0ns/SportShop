digraph G { graph[fontname="DejaVu Sans",label="Структурная карта Константайна (оформление заказа)",labelloc=t,fontsize=18]; node[fontname="DejaVu Sans",fontsize=11,shape=box]; edge[fontname="DejaVu Sans",fontsize=10];
